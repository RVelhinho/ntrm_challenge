{
  "name": "nutrium",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -n API,WEB \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd backend && bin/rails server -p 3000",
    "dev:web": "pnpm --dir frontend dev",
    "setup": "cd backend && bundle install && bin/rails db:prepare && cd ../frontend && pnpm install",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "cd backend && bundle exec rspec",
    "test:web": "pnpm --dir frontend test",
    "lint": "pnpm lint:api && pnpm lint:web",
    "lint:api": "cd backend && bundle exec rubocop",
    "lint:web": "pnpm --dir frontend lint",
    "typecheck": "pnpm --dir frontend typecheck",
    "openapi": "cd backend && RAILS_ENV=test bundle exec rake rswag:specs:swaggerize",
    "codegen": "pnpm --dir frontend codegen",
    "api:sync": "pnpm openapi && pnpm codegen",
    "check": "pnpm api:sync && pnpm lint && pnpm typecheck && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.8.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
